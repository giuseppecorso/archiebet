{
	servers {
		trusted_proxies static private_ranges
	}
}

# HTTPS e certificato sono gestiti dal Nginx dell'host (Certbot).
# Caddy ascolta solo in locale sulla porta 8090 del server.
# Archie è ad uso privato: si entra solo con il login e i motori di ricerca non devono indicizzarlo.
:80 {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	reverse_proxy frontend:80
}
