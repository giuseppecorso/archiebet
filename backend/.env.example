# Copia questo file in .env (stessa cartella) e modifica i valori.
# Il file .env NON va mai su Git: contiene le chiavi API.

# development | production
APP_ENV=development

# Database: SQLite in locale. Per PostgreSQL basta cambiare questa riga, es.
# DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/archiebet
DATABASE_URL=sqlite:///data/archiebet.db

# Login
SESSION_DAYS=30
# true solo quando l'app gira su HTTPS
COOKIE_SECURE=false

# Cache delle fonti dati (una cartella per fonte)
DATA_CACHE_DIR=data/cache

# AI: tetto di spesa mensile globale e quota per utente (euro)
AI_MONTHLY_BUDGET_EUR=15
AI_USER_MONTHLY_QUOTA_EUR=10
# Percentuale del tetto oltre la quale si mostra un avviso
AI_BUDGET_WARNING_RATIO=0.8

# Chiavi API (si aggiungono nelle fasi successive)
# API_FOOTBALL_KEY=
# ODDSPAPI_KEY=
# ANTHROPIC_API_KEY=
