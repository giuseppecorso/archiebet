# Copia questo file in .env (stessa cartella) e modifica i valori.
# Il file .env NON va mai su Git: contiene le chiavi API.

# development | production
APP_ENV=development

# Database: SQLite in locale. Per PostgreSQL basta cambiare questa riga, es.
# DATABASE_URL=postgresql+psycopg://utente:password@localhost:5432/archiebet
DATABASE_URL=sqlite:///data/archiebet.db

# Login
SESSION_DAYS=30
# true solo quando l'app gira su HTTPS
COOKIE_SECURE=false

# Cache delle fonti dati (una cartella per fonte)
DATA_CACHE_DIR=data/cache

# Aggiornamento automatico di partite e quote (ogni N ore, mentre il backend è acceso)
SYNC_ENABLED=true
SYNC_INTERVAL_HOURS=6

# AI: tetto di spesa mensile globale e quota per utente (euro)
AI_MONTHLY_BUDGET_EUR=15
AI_USER_MONTHLY_QUOTA_EUR=10
# Percentuale del tetto oltre la quale si mostra un avviso
AI_BUDGET_WARNING_RATIO=0.8

# API-Football: chiave personale (dashboard.api-football.com), campionati e stagioni
# Piano gratuito: 100 richieste/giorno, solo stagioni 2022-2024. Con il piano a pagamento aggiungere 2025,2026
# e i campionati 135 (Serie A) e 136 (Serie B) per i risultati aggiornati.
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=138,942,943
API_FOOTBALL_SEASONS=2022,2023,2024
API_FOOTBALL_DAILY_RESERVE=10

# Altre chiavi (fasi successive)
# ODDSPAPI_KEY=
# ANTHROPIC_API_KEY=
